# Copy to .env once, then replace every CHANGE_ME value with a unique secret.
# Keep .env readable only by the deployment account (chmod 600 .env).

# Application
APP_ENV=production
PORT=3000
STORAGE_DRIVER=local
CORS_ALLOWED_ORIGINS=https://admin.example.com
PUBLIC_BASE_URL=https://api.example.com
API_BIND_ADDRESS=127.0.0.1
API_PORT=3000
BACKEND_IMAGE=rida-backend:local
API_MEMORY_LIMIT=512m
DB_MEMORY_LIMIT=768m
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

# App and staff authentication secrets (generate separate values with: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_generate_a_unique_random_secret
APP_ACCESS_TTL=15m
# Refresh inactivity and absolute maximum (Go duration syntax).
APP_REFRESH_INACTIVITY_TTL=2160h
APP_REFRESH_ABSOLUTE_TTL=8760h
STAFF_JWT_SECRET=CHANGE_ME_generate_a_different_random_secret
STAFF_TOTP_KEY=CHANGE_ME_generate_64_hex_characters_with_openssl_rand_hex_32
STAFF_ACCESS_TTL=15m
STAFF_REFRESH_TTL=7d
STAFF_REQUIRE_2FA_FOR_ADMIN=true
# Used only by the one-time create-admin command, not the running API.
STAFF_BOOTSTRAP_PASSWORD=CHANGE_ME_to_a_unique_strong_admin_password

# PostgreSQL: the admin role is for database initialization and migrations only.
# The less-privileged DB_USER role is used by the backend at runtime.
DB_HOST=db
DB_PORT=5432
DB_NAME=ride
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=CHANGE_ME_to_a_long_random_database_admin_password
DB_USER=ride_app
DB_PASSWORD=CHANGE_ME_to_a_different_long_random_app_password
DB_SSLMODE=verify-full

# Local storage is persisted in the Docker uploads_data volume.
EXPORT_DIR=/app/uploads/private/exports

# Optional R2 storage (required only when STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=

# Android ID-token sign-in: Google Web OAuth client ID (also supplied to Android as a public ID).
# Browser redirect OAuth below uses its own client ID/secret and callback allowlist.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
GOOGLE_REDIRECT_ALLOWED_URLS=

# Optional Android push. The durable app inbox works with PUSH_PROVIDER=none.
# To enable FCM, provide an actual Firebase project and mount a service-account
# JSON through docker-compose.fcm.yml. Never put the JSON or key in Git/Android.
PUSH_PROVIDER=none
FIREBASE_PROJECT_ID=
# Generate with: openssl rand -hex 32 (do not change after devices register).
PUSH_TOKEN_ENCRYPTION_KEY=

# Payment provider settings; leave unset until a local provider is integrated.
PAYMENT_PROVIDER=mock
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_PREVIOUS_SECRET=
PAYMENT_ENCRYPTION_KEY=
DRIVER_MAX_NEGATIVE_BALANCE=10000
PAYOUT_MIN=1000
PAYOUT_AUTO_APPROVE_MAX=10000
REFUND_SUPPORT_LIMIT=5000

# Account retention and operational jobs
DELETION_GRACE_DAYS=14
EXPORT_TTL_HOURS=168
FINANCIAL_RETENTION_YEARS=0
RUN_BACKGROUND_JOBS=false
REPORT_FLAG_THRESHOLD=3
REPORT_FLAG_WINDOW_DAYS=30
SOS_ACK_SLA_SECONDS=60
SOS_ONCALL_PHONES=
SOS_LOCATION_RETENTION_DAYS=30
SOS_FALSE_ALARM_THRESHOLD=3
DEVICE_HASH_PEPPER=

# Ride dispatch and fare configuration; set rates only after approval.
RIDE_BASE_FARE_TZS=0
RIDE_PER_KM_FARE_TZS=0
RIDE_PER_MINUTE_FARE_TZS=0
RIDE_ESTIMATED_SPEED_KMPH=20
RIDE_OFFER_TIMEOUT_SECONDS=30
RIDE_SEARCH_RADIUS_KM=10
DISABLE_LEGACY_RATINGS=false
