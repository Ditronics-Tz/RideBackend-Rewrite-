# Server configuration
APP_ENV=development
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=
PORT=
CORS_ALLOWED_ORIGINS=

# App realm JWT
JWT_SECRET=

# Staff realm auth & security
STAFF_JWT_SECRET=
STAFF_ACCESS_TTL=
STAFF_REFRESH_TTL=
STAFF_TOTP_KEY=
STAFF_REQUIRE_2FA_FOR_ADMIN=
STAFF_BOOTSTRAP_PASSWORD=

# Database credentials
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=

# Account data protection (financial retention period requires legal confirmation)
DELETION_GRACE_DAYS=14
EXPORT_TTL_HOURS=168
EXPORT_DIR=./uploads/private/exports
REPORT_FLAG_THRESHOLD=3
REPORT_FLAG_WINDOW_DAYS=30

# Safety operations
SOS_ACK_SLA_SECONDS=60
SOS_ONCALL_PHONES=
SOS_LOCATION_RETENTION_DAYS=30
SOS_FALSE_ALARM_THRESHOLD=3
PUBLIC_BASE_URL=http://localhost:3000

# Payments: mock is for local/offline development only; production must configure gateway
PAYMENT_PROVIDER=mock
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_PREVIOUS_SECRET=
PAYMENT_ENCRYPTION_KEY=
DRIVER_MAX_NEGATIVE_BALANCE=10000
PAYOUT_MIN=1000
PAYOUT_AUTO_APPROVE_MAX=10000
REFUND_SUPPORT_LIMIT=5000

# Fraud device hashing: use a long random secret and rotate with a planned rehash
DEVICE_HASH_PEPPER=
FINANCIAL_RETENTION_YEARS=0
RUN_BACKGROUND_JOBS=false

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
