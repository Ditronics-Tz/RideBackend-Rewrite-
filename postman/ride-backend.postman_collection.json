{
  "info": {
    "name": "Ride Backend API",
    "description": "Ride backend (Fiber v2 + Postgres) featuring strict realm separation between App Users (passengers & drivers) and Staff (admin & support). Every HTTP route starts with /api/v1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "driver_token", "value": "" },
    { "key": "passenger_token", "value": "" },
    { "key": "staff_access_token", "value": "" },
    { "key": "staff_refresh_token", "value": "" },
    { "key": "driver_id", "value": "" },
    { "key": "passenger_id", "value": "" },
    { "key": "staff_id", "value": "" }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/health"
          }
        }
      ]
    },
    {
      "name": "App Realm",
      "description": "App realm for drivers and passengers. Tokens carry iss='ride-backend', aud='app'.",
      "item": [
        {
          "name": "Auth",
          "item": [
            {
              "name": "Register Driver",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/api/v1/auth/register",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Juma Driver\",\n  \"email\": \"juma@driver.tz\",\n  \"password\": \"secret123\",\n  \"role\": \"driver\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var j = pm.response.json();",
                      "if (j.token) pm.collectionVariables.set('driver_token', j.token);",
                      "if (j.user && j.user.id) pm.collectionVariables.set('driver_id', j.user.id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Register Passenger",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/api/v1/auth/register",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Asha Pax\",\n  \"email\": \"asha@pax.tz\",\n  \"password\": \"secret123\",\n  \"role\": \"passenger\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var j = pm.response.json();",
                      "if (j.token) pm.collectionVariables.set('passenger_token', j.token);",
                      "if (j.user && j.user.id) pm.collectionVariables.set('passenger_id', j.user.id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Login Driver",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/api/v1/auth/login",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"juma@driver.tz\",\n  \"password\": \"secret123\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var j = pm.response.json();",
                      "if (j.token) pm.collectionVariables.set('driver_token', j.token);",
                      "if (j.user && j.user.id) pm.collectionVariables.set('driver_id', j.user.id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Login Passenger",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/api/v1/auth/login",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"asha@pax.tz\",\n  \"password\": \"secret123\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var j = pm.response.json();",
                      "if (j.token) pm.collectionVariables.set('passenger_token', j.token);",
                      "if (j.user && j.user.id) pm.collectionVariables.set('passenger_id', j.user.id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Get My Account",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/api/v1/auth/me",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{driver_token}}", "type": "string" }] }
              }
            },
            {
              "name": "Google Login (redirect)",
              "request": { "method": "GET", "url": "{{base_url}}/api/v1/auth/google" }
            }
          ]
        },
        {
          "name": "Driver Profile",
          "item": [
            {
              "name": "Get My Driver Profile",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/api/v1/driver/profile/me",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{driver_token}}", "type": "string" }] }
              }
            },
            {
              "name": "Update My Driver Profile",
              "request": {
                "method": "PUT",
                "url": "{{base_url}}/api/v1/driver/profile/me",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{driver_token}}", "type": "string" }] },
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"licence_number\": \"LIC-12345\",\n  \"vehicle_card_number\": \"KADI-999\",\n  \"plate_number\": \"T123 ABC\"\n}"
                }
              }
            },
            {
              "name": "Upload Driver Images",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/api/v1/driver/profile/me/images",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{driver_token}}", "type": "string" }] },
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    { "key": "licence_image", "type": "file", "src": "/path/to/licence.png" },
                    { "key": "profile_picture", "type": "file", "src": "/path/to/profile.png" }
                  ]
                }
              }
            },
            {
              "name": "Get Driver By ID",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/api/v1/driver/profile/{{driver_id}}",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{passenger_token}}", "type": "string" }] }
              }
            }
          ]
        },
        {
          "name": "Passenger Profile",
          "item": [
            {
              "name": "Get My Passenger Profile",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/api/v1/passenger/profile/me",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{passenger_token}}", "type": "string" }] }
              }
            },
            {
              "name": "Update My Passenger Profile",
              "request": {
                "method": "PUT",
                "url": "{{base_url}}/api/v1/passenger/profile/me",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{passenger_token}}", "type": "string" }] },
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"full_name\": \"Asha Updated\",\n  \"phone\": \"+255700000000\"\n}"
                }
              }
            },
            {
              "name": "Upload Passenger Image",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/api/v1/passenger/profile/me/image",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{passenger_token}}", "type": "string" }] },
                "body": {
                  "mode": "formdata",
                  "formdata": [{ "key": "profile_picture", "type": "file", "src": "/path/to/profile.png" }]
                }
              }
            },
            {
              "name": "Get Passenger By ID",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/api/v1/passenger/profile/{{passenger_id}}",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{driver_token}}", "type": "string" }] }
              }
            }
          ]
        },
        {
          "name": "Ratings",
          "item": [
            {
              "name": "Passenger Rates Driver",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/api/v1/ratings/",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{passenger_token}}", "type": "string" }] },
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"to_user_id\": \"{{driver_id}}\",\n  \"score\": 5,\n  \"comment\": \"Safari nzuri sana\"\n}"
                }
              }
            },
            {
              "name": "Driver Rates Passenger",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/api/v1/ratings/",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{driver_token}}", "type": "string" }] },
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"to_user_id\": \"{{passenger_id}}\",\n  \"score\": 4,\n  \"comment\": \"Abiria mzuri\"\n}"
                }
              }
            },
            {
              "name": "List Ratings For User",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/api/v1/ratings/user/{{driver_id}}",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{passenger_token}}", "type": "string" }] }
              }
            }
          ]
        },
        {
          "name": "Files (Private Documents)",
          "item": [
            {
              "name": "Get Licence Document (Owning Driver or Staff only)",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/api/v1/files/licences/{{driver_id}}",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{driver_token}}", "type": "string" }] }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Staff Realm",
      "description": "Staff realm for admin and support members. Completely isolated from app realm. Tokens carry iss='ride-backend', aud='staff'.",
      "item": [
        {
          "name": "Staff Auth",
          "item": [
            {
              "name": "Staff Login",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/api/v1/staff/auth/login",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"admin@ride.tz\",\n  \"password\": \"SecureAdminPass123!\",\n  \"totp_code\": \"\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var j = pm.response.json();",
                      "if (j.access_token) pm.collectionVariables.set('staff_access_token', j.access_token);",
                      "if (j.refresh_token) pm.collectionVariables.set('staff_refresh_token', j.refresh_token);",
                      "if (j.user && j.user.id) pm.collectionVariables.set('staff_id', j.user.id);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Staff Refresh Token",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/api/v1/staff/auth/refresh",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refresh_token\": \"{{staff_refresh_token}}\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var j = pm.response.json();",
                      "if (j.access_token) pm.collectionVariables.set('staff_access_token', j.access_token);",
                      "if (j.refresh_token) pm.collectionVariables.set('staff_refresh_token', j.refresh_token);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Get My Staff Profile",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/api/v1/staff/auth/me",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] }
              }
            },
            {
              "name": "Change Password",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/api/v1/staff/auth/change-password",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] },
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"current_password\": \"OldPassword123!\",\n  \"new_password\": \"NewSecurePassword123!\"\n}"
                }
              }
            },
            {
              "name": "2FA Setup",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/api/v1/staff/auth/2fa/setup",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] }
              }
            },
            {
              "name": "2FA Verify",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/api/v1/staff/auth/2fa/verify",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] },
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"code\": \"123456\"\n}"
                }
              }
            },
            {
              "name": "2FA Disable",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/api/v1/staff/auth/2fa/disable",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] },
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"password\": \"SecureAdminPass123!\",\n  \"code\": \"123456\"\n}"
                }
              }
            },
            {
              "name": "Logout Session",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/api/v1/staff/auth/logout",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] },
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refresh_token\": \"{{staff_refresh_token}}\"\n}"
                }
              }
            },
            {
              "name": "Logout All Sessions",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/api/v1/staff/auth/logout-all",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] }
              }
            }
          ]
        },
        {
          "name": "Admin & Support Operations",
          "item": [
            {
              "name": "List All App Users (Support/Admin)",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/api/v1/admin/users",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] }
              }
            },
            {
              "name": "Get App User By ID (Support/Admin)",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/api/v1/admin/users/{{passenger_id}}",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] }
              }
            },
            {
              "name": "Verify Driver (Support/Admin)",
              "request": {
                "method": "PATCH",
                "url": "{{base_url}}/api/v1/admin/drivers/{{driver_id}}/verify",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] },
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"verified\": true\n}"
                }
              }
            },
            {
              "name": "Dashboard Stats (Support/Admin)",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/api/v1/admin/stats",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] }
              }
            },
            {
              "name": "List Rides (Support/Admin)",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/api/v1/admin/rides",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] }
              }
            },
            {
              "name": "List Complaints (Support/Admin)",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/api/v1/admin/complaints",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] }
              }
            },
            {
              "name": "Work Complaint (Support/Admin)",
              "request": {
                "method": "PATCH",
                "url": "{{base_url}}/api/v1/admin/complaints/123",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] }
              }
            },
            {
              "name": "List Tickets (Support/Admin)",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/api/v1/admin/tickets",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] }
              }
            },
            {
              "name": "Work Ticket (Support/Admin)",
              "request": {
                "method": "PATCH",
                "url": "{{base_url}}/api/v1/admin/tickets/123",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] }
              }
            },
            {
              "name": "Update App User Role (Admin Only)",
              "request": {
                "method": "PATCH",
                "url": "{{base_url}}/api/v1/admin/users/{{passenger_id}}/role",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] },
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"role\": \"driver\"\n}"
                }
              }
            },
            {
              "name": "Read Audit Logs (Admin Only)",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/api/v1/admin/audit-logs",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] }
              }
            }
          ]
        },
        {
          "name": "Staff Management (Admin Only)",
          "item": [
            {
              "name": "Create Staff Member",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/api/v1/admin/staff",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] },
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Support Officer\",\n  \"email\": \"support.officer@ride.tz\",\n  \"role\": \"support\"\n}"
                }
              }
            },
            {
              "name": "List Staff Members",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/api/v1/admin/staff",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] }
              }
            },
            {
              "name": "Update Staff Member (Name / IsActive)",
              "request": {
                "method": "PATCH",
                "url": "{{base_url}}/api/v1/admin/staff/{{staff_id}}",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] },
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Updated Support Name\",\n  \"is_active\": true\n}"
                }
              }
            },
            {
              "name": "Update Staff Role",
              "request": {
                "method": "PATCH",
                "url": "{{base_url}}/api/v1/admin/staff/{{staff_id}}/role",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] },
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"role\": \"admin\"\n}"
                }
              }
            },
            {
              "name": "Reset Staff Password",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/api/v1/admin/staff/{{staff_id}}/reset-password",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] }
              }
            },
            {
              "name": "Revoke Staff Sessions",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/api/v1/admin/staff/{{staff_id}}/revoke-sessions",
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{staff_access_token}}", "type": "string" }] }
              }
            }
          ]
        }
      ]
    }
  ]
}
